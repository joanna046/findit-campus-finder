# FindIt Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your actual settings.
# NEVER commit backend/.env to version control.

# Database Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=findit_db
DB_USER=findit_user
DB_PASSWORD=your_mysql_password_here

# Authentication Signing Secret (Minimum 32 characters)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars_long
